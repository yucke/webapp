{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wos-rally-tracker",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RALLY_ROOMS",
        "class_name": "RallyRoom"
      },
      {
        "name": "FORTLESS_ROOMS",
        "class_name": "FortlessRoom"
      },
      {
        "name": "COMMANDER_ROOMS",
        "class_name": "CommanderRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RallyRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "FortlessRoom",
        "CommanderRoom"
      ]
    }
  ],
  "assets": {
    "directory": "."
  }
}